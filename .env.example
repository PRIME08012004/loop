# Keep this key server-side. It is read only by app/api/analyze/route.ts.
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=
# Required for NextAuth/Auth.js
AUTH_SECRET=generate_a_long_random_secret
AUTH_URL=http://localhost:3000

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Passwordless email / SMTP
AUTH_EMAIL_SERVER=
AUTH_EMAIL_FROM=