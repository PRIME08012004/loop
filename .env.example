# Keep this key server-side. Used by Ask LOOP, reports, analyze, and sentiment.
OPENROUTER_API_KEY=your_openrouter_key
# Optional global override. If unset, each plan picks its own model (see lib/plans.ts).
OPENROUTER_MODEL=
OPENROUTER_SENTIMENT_MODEL=
# Set to 1 to force OPENROUTER_MODEL for every plan (local debugging only).
OPENROUTER_FORCE_MODEL=

# Razorpay (Settings → Billing). Use test keys locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Required for NextAuth/Auth.js
AUTH_SECRET=generate_a_long_random_secret
AUTH_URL=http://localhost:3000

# Google OAuth (login)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google Play integration (can reuse AUTH_GOOGLE_* or set dedicated credentials)
GOOGLE_PLAY_CLIENT_ID=
GOOGLE_PLAY_CLIENT_SECRET=

# Encrypt integration tokens at rest (use a long random string)
INTEGRATION_ENCRYPTION_KEY=generate_a_long_random_secret

# Vercel Cron auth — Vercel sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate_a_long_random_secret

# GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Passwordless email / SMTP
AUTH_EMAIL_SERVER=
AUTH_EMAIL_FROM=

# PostgreSQL
DATABASE_URL=
